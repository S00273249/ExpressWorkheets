@endpoint = http://localhost:3000/api/v1

### Register a new user
POST {{endpoint}}/auth/register HTTP/1.1
Content-Type: application/json

{
    "name": "Daniel",
    "email": "daniel.task10@example.com",
    "password": "password123"
}

###

### Login successfully
# @name login
POST {{endpoint}}/auth/login HTTP/1.1
Content-Type: application/json

{
    "email": "daniel.task10@example.com",
    "password": "password123"
}

###

@accessToken = {{login.response.body.token}}

### Login with incorrect password
POST {{endpoint}}/auth/login HTTP/1.1
Content-Type: application/json

{
    "email": "daniel.task10@example.com",
    "password": "wrongpassword"
}

###

### Login with nonexistent email
POST {{endpoint}}/auth/login HTTP/1.1
Content-Type: application/json

{
    "email": "nonexistent@example.com",
    "password": "password123"
}

###

### Get current user - without token
GET {{endpoint}}/auth/me HTTP/1.1

###

### Get current user - with token
GET {{endpoint}}/auth/me HTTP/1.1
Authorization: Bearer {{accessToken}}

###

### Get all cars - without token
GET {{endpoint}}/cars HTTP/1.1
x-api-key: blahblah

###

### Get all cars - with token
GET {{endpoint}}/cars HTTP/1.1
x-api-key: blahblah
Authorization: Bearer {{accessToken}}