@endpoint = http://localhost:3000/api/v1/cars

###

# @name createCar
POST {{endpoint}} HTTP/1.1
Content-Type: application/json

{
    "make": "Toyota",
    "model": "Corolla"
}

###

GET {{endpoint}} HTTP/1.1
Content-Type: application/json

###

GET {{endpoint}}/{{createCar.response.body.$._id}} HTTP/1.1
Content-Type: application/json

###

PUT {{endpoint}}/{{createCar.response.body.$._id}} HTTP/1.1
Content-Type: application/json

{
    "make": "Toyota",
    "model": "Yaris"
}

###

DELETE {{endpoint}}/{{createCar.response.body.$._id}} HTTP/1.1
Content-Type: application/json